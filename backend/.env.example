# =============================================================================
# St. Vincent's School HRMS - Backend Environment Configuration Example
# Copy this file to .env and provide your deployment-specific values.
# NEVER commit the real .env file or real secrets to version control.
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Individual Parameters - Local or Cloud)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_hrms
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# Cloud Database URL (Optional: takes precedence over individual DB parameters if provided)
# e.g., postgresql://user:password@host:port/database
# DATABASE_URL=

# Set to true if connecting to a cloud-hosted PostgreSQL database requiring SSL (e.g. Render, Supabase, Neon)
DB_SSL=false

# Authentication & Security
JWT_SECRET=your_strong_random_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# CORS Configuration (Optional: allowed origin(s) in production, comma-separated)
# e.g., https://your-school-hrms-frontend.vercel.app
# CORS_ORIGIN=

# Frontend Application URL (Used in invitation email links)
FRONTEND_URL=http://localhost:5173

# Email Provider Configuration (resend, sendgrid, smtp)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@stvincents.edu

# SMS Provider Configuration (twilio, msg91, aws_sns)
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=STVINCENTS
TWILIO_ACCOUNT_SID=
